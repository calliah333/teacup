USERNAME=eatme
PASSWORD=drinkme
# Optional: enables x-api-key auth, e.g. for chibisafe-compatible clients on /api/upload
# Generate one and append it to .env:
#   printf '\nAPI_KEY=%s\n' "$(openssl rand -hex 32)" >> .env
# API_KEY=
PORT=8080
MAX_FILE_SIZE_MB=100

# Optional upload limits (defaults shown). MAX_TTL_HOURS unset = no maximum.
# DEFAULT_TTL_HOURS=3
# MAX_TTL_HOURS=
# ALLOW_PERMANENT=true
# MAX_FILES_PER_REQUEST=20
